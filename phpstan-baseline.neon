parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \=\=\= between mixed and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Database/Database.php

		-
			message: '#^Undefined variable\: \$emi$#'
			identifier: variable.undefined
			count: 1
			path: app/Services/LoanService.php

		-
			message: '#^Undefined variable\: \$principal$#'
			identifier: variable.undefined
			count: 1
			path: app/Services/LoanService.php

		-
			message: '#^Undefined variable\: \$tenure$#'
			identifier: variable.undefined
			count: 1
			path: app/Services/LoanService.php

		-
			message: '#^Function config not found\.$#'
			identifier: function.notFound
			count: 1
			path: app/Services/ReportService.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: app/Services/Router.php
