# FinTrack Pro Backend - gitignore

# Dependencies
/vendor/

# Environment configurations
.env
.env.local
.env.development
.env.staging
.env.production

# Logs and storage
/storage/logs/*.log
!/storage/logs/.gitkeep

# IDE and Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Testing
.env.testing
/node_modules/
.phpunit.result.cache
playwright-report/
test-results/
