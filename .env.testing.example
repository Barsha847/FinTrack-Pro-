# FinTrack Pro - Testing Environment Configuration
# DO NOT include production credentials here.
# Copy this to .env.testing for local test execution.

APP_NAME=FinTrackProTest
APP_ENV=testing
APP_URL=http://localhost:8000
APP_KEY=fintrack_test_dummy_app_key_32_chars_long

# Test Database Configuration
# This MUST be a separate database from your development database.
# The automated tests may reset this database!
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fintrack_test_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Mail is typically disabled/mocked in tests
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME=FinTrackTest
